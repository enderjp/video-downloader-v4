# Copy to .env.production and adjust values
PORT=3000
PUPPETEER_HEADLESS=new
PUPPETEER_TIMEOUT=60000
FACEBOOK_LOCALE=en-US,en;q=0.9
BLOCK_HEAVY_ASSETS=true
PUPPETEER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/121.0.0.0 Safari/537.36
FACEBOOK_COOKIES_PATH=/run/secrets/facebook-cookies.txt
COOKIE_ADMIN_TOKEN=replace-with-a-long-random-token
COOKIE_ADMIN_MAX_BYTES=1048576
COOKIE_AUDIT_LOG_PATH=/app/snapshots/cookie-rotation.audit.jsonl
COOKIE_ADMIN_ACTOR_HEADER=x-cookie-actor
FACEBOOK_DEBUG_SNAPSHOTS=true
FACEBOOK_DEBUG_DIR=/app/snapshots
